# Neon PostgreSQL connection string (direct or pooled)
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server Port (default 8081 for local development)
PORT=8081
HOST=0.0.0.0

# Allowed CORS origins (comma-separated or single)
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=https://edcbitmesra.in

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Recruitment Admin Authentication
RECRUITMENT_ADMIN_USERNAME=edc_admin
RECRUITMENT_ADMIN_PASSWORD=change_this_secure_password_in_production
RECRUITMENT_SESSION_SECRET=change_this_session_secret_in_production

